{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    "src/schema.ts",
    "src/**/*.test.ts",
    "test/**/*.test.ts",
    "test/**/*.types.ts",
    "test/fixtures/*.mjs",
    "examples/*/**/*.ts",
    "**/vite.config.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/node_modules/**", "docs/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "fallow",
    "@vitest/coverage-istanbul"
  ],
  "ignoreExports": [
    {
      "file": "src/Assemble.ts",
      "exports": ["CollectionDocument", "Options", "Ref", "collection", "resource"]
    },
    {
      "file": "src/Document.ts",
      "exports": ["Wire"]
    },
    {
      "file": "src/FlatQuery.ts",
      "exports": ["suppliedValue"]
    },
    {
      "file": "src/Negotiation.ts",
      "exports": ["Options", "errorResponse", "make"]
    },
    {
      "file": "src/Registry.ts",
      "exports": ["Family", "Options", "layer"]
    },
    {
      "file": "src/ResourceHandlers.ts",
      "exports": ["Config", "make"]
    },
    {
      "file": "src/ServerErrors.ts",
      "exports": ["ErrorDocument", "Forbidden", "errorResponse", "pathToJsonPointer"]
    },
    // Each conformance tier module exports its rule list as `rules`; the
    // Conformance module imports each tier as a namespace (SpecRules.rules,
    // ProfileRules.rules, SortRules.rules), so the shared name is the design,
    // not a duplicate.
    { "file": "src/internal/conformance/spec.ts", "exports": ["rules"] },
    { "file": "src/internal/conformance/profile.ts", "exports": ["rules"] },
    { "file": "src/internal/conformance/sort.ts", "exports": ["rules"] },
    // Likewise `Samples.snapshot` / `targets` and `WriteFixtures.snapshot` /
    // `targets`: each module's own ledger, read through its namespace.
    { "file": "src/internal/conformance/samples.ts", "exports": ["snapshot", "targets"] },
    { "file": "src/internal/conformance/write.ts", "exports": ["snapshot", "targets"] },
    {
      "file": "src/internal/media.ts",
      "exports": ["parseMediaType"]
    }
  ],
  "health": {
    "coverage": "coverage/coverage-final.json"
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "warn",
    "stale-suppressions": "warn"
  }
}
