{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Resolve the library to its source, exactly as the root config does, so
    // the example is type-checked against the live `src/`. Relative to this
    // file; TypeScript 7 removed `baseUrl`.
    "paths": {
      "@thomasfosterau/effect-jsonapi": ["../../src/index.ts"],
      "@thomasfosterau/effect-jsonapi/schema": ["../../src/schema.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
