{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-jsonapi",
  "version": "0.18.0",
  "description": "Type-safe, spec-compliant JSON:API v1.1 on Effect's HttpApi.",
  "keywords": [
    "api",
    "effect",
    "functional-programming",
    "json-api",
    "jsonapi",
    "schema",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-jsonapi#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-jsonapi/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-jsonapi.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./ApiError": {
      "types": "./dist/ApiError.d.ts",
      "default": "./dist/ApiError.js"
    },
    "./Assemble": {
      "types": "./dist/Assemble.d.ts",
      "default": "./dist/Assemble.js"
    },
    "./Atomic": {
      "types": "./dist/Atomic.d.ts",
      "default": "./dist/Atomic.js"
    },
    "./Client": {
      "types": "./dist/Client.d.ts",
      "default": "./dist/Client.js"
    },
    "./Conformance": {
      "types": "./dist/Conformance.d.ts",
      "default": "./dist/Conformance.js"
    },
    "./Document": {
      "types": "./dist/Document.d.ts",
      "default": "./dist/Document.js"
    },
    "./Endpoint": {
      "types": "./dist/Endpoint.d.ts",
      "default": "./dist/Endpoint.js"
    },
    "./Filter": {
      "types": "./dist/Filter.d.ts",
      "default": "./dist/Filter.js"
    },
    "./FlatQuery": {
      "types": "./dist/FlatQuery.d.ts",
      "default": "./dist/FlatQuery.js"
    },
    "./Group": {
      "types": "./dist/Group.d.ts",
      "default": "./dist/Group.js"
    },
    "./Handlers": {
      "types": "./dist/Handlers.d.ts",
      "default": "./dist/Handlers.js"
    },
    "./Idempotency": {
      "types": "./dist/Idempotency.d.ts",
      "default": "./dist/Idempotency.js"
    },
    "./Include": {
      "types": "./dist/Include.d.ts",
      "default": "./dist/Include.js"
    },
    "./Lid": {
      "types": "./dist/Lid.d.ts",
      "default": "./dist/Lid.js"
    },
    "./MediaType": {
      "types": "./dist/MediaType.d.ts",
      "default": "./dist/MediaType.js"
    },
    "./Middleware": {
      "types": "./dist/Middleware.d.ts",
      "default": "./dist/Middleware.js"
    },
    "./Negotiation": {
      "types": "./dist/Negotiation.d.ts",
      "default": "./dist/Negotiation.js"
    },
    "./Query": {
      "types": "./dist/Query.d.ts",
      "default": "./dist/Query.js"
    },
    "./Registry": {
      "types": "./dist/Registry.d.ts",
      "default": "./dist/Registry.js"
    },
    "./Relationship": {
      "types": "./dist/Relationship.d.ts",
      "default": "./dist/Relationship.js"
    },
    "./Resource": {
      "types": "./dist/Resource.d.ts",
      "default": "./dist/Resource.js"
    },
    "./ResourceHandlers": {
      "types": "./dist/ResourceHandlers.d.ts",
      "default": "./dist/ResourceHandlers.js"
    },
    "./ServerErrors": {
      "types": "./dist/ServerErrors.d.ts",
      "default": "./dist/ServerErrors.js"
    },
    "./Sort": {
      "types": "./dist/Sort.d.ts",
      "default": "./dist/Sort.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "pnpm publish --recursive --access public --no-git-checks --ignore-scripts && changeset git-tag",
    "prepublishOnly": "vp run build",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.27.0"
}
