{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-jsonapi",
  "version": "0.14.0",
  "description": "Type-safe, spec-compliant JSON:API v1.1 on Effect's HttpApi.",
  "keywords": [
    "api",
    "effect",
    "functional-programming",
    "json-api",
    "jsonapi",
    "schema",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-jsonapi#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-jsonapi/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-jsonapi.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "pnpm publish --access public --no-git-checks && changeset tag",
    "prepublishOnly": "vp run build",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.27.0"
}
