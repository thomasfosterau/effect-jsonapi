{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Copied from the consuming applications so the library compiles under
    // exactly the options they use. `erasableSyntaxOnly` because the apps load
    // TypeScript under Node's strip-only loader; a library file that uses
    // enums / namespaces / parameter properties would fail there.
    "erasableSyntaxOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    // Source imports are written `./x.js` (what `nodenext` consumers and
    // `@effect/docgen`'s own compiler pass both resolve); the bundler
    // resolution above maps them to `./x.ts`. `vp pack` (tsdown) rewrites
    // nothing — it bundles each entry point.
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    // Every optional member a caller can pass `undefined` for is spelled
    // `?: T | undefined` because of this flag.
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // The severities below keep every Effect rule visible in the editor,
        // but a "warning" still fails the patched tsc by default — this flag
        // is what actually makes warnings non-blocking in the check tasks.
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "asyncFunction": "warning",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "newPromise": "warning",
          "nodeBuiltinImport": "warning",
          "preferSchemaOverJson": "warning",
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          // Effect marks much of `effect/http` and `effect/http-api`
          // `@stability unstable`, so at "warning" every import of the HTTP
          // surface this library is built on would warn. "suggestion" keeps
          // the hint in the editor without drowning the type gate (#205).
          // The rule exists from @effect/tsgo 0.47.0; earlier releases accept
          // and ignore the key.
          "unstableApiUsage": "suggestion",
          "unsafeEffectTypeAssertion": "warning"
        }
      }
    ]
  }
}
