.DS_Store
node_modules
.env
.env.*
!.env.example
.tmp
.tools
.fallow
fallow.sarif
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.pnpm-store
vite.config.*.timestamp*
*.log

# Vitest coverage reports.
coverage/

# TypeScript incremental build cache. Regenerated; never committed.
*.tsbuildinfo

# Built package output (`vp run build`); published to npm, never committed.
dist/

# The Vite+ task cache and vitest scratch dirs.
.vite/
# The generated git-hook runner; the editable hook itself is committed.
.vite-hooks/_/

# Output of `pnpm pack` / `npm pack`.
*.tgz

# Generated API documentation (built by `vp run docgen`); hand-written design
# notes in docs/ are tracked explicitly.
/docs/*
!/docs/filter-grammar.md
!/docs/conformance.md
!/docs/idempotency.md
!/docs/guides/
.vitest/
